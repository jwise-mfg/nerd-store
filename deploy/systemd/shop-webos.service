[Unit]
Description=shop.webosarchive.org storefront
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cesmii
Group=cesmii
WorkingDirectory=/home/cesmii/repos/nerd-store

# TENANT selects which build this unit serves. It must match the dist
# directory below; the app also cross-checks the Host header at request time.
Environment=TENANT=webos
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4322
# All configuration -- Stripe keys, mail, database location -- lives in this
# one file. Both units read the same file: they bill through the same Stripe
# account, so separate copies would only be two places to update one key.
Environment=CONFIG_PATH=/home/cesmii/repos/nerd-store/config.json

ExecStart=/usr/bin/node /home/cesmii/repos/nerd-store/apps/storefront/dist-webos/server/entry.mjs
Restart=on-failure
RestartSec=3

# --- hardening -------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# NOT ProtectHome=yes: the application lives under /home/cesmii/repos, so
# hiding /home would make ExecStart fail with a bare "No such file".
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
# The only writable path. Both units share this directory but touch different
# files in it -- i3x.db and webos.db never overlap.
ReadWritePaths=/home/cesmii/repos/nerd-store/data

[Install]
WantedBy=multi-user.target
