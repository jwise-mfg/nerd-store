[Unit]
Description=Back up the tenant databases

[Service]
Type=oneshot
User=cesmii
Group=cesmii
WorkingDirectory=/home/cesmii/repos/nerd-store
Environment=CONFIG_PATH=/home/cesmii/repos/nerd-store/config.json
Environment=BACKUP_DIR=/home/cesmii/backups/nerd-store
ExecStart=/home/cesmii/repos/nerd-store/scripts/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/cesmii/repos/nerd-store/data /home/cesmii/backups/nerd-store
