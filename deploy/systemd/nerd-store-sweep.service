[Unit]
Description=Release expired stock reservations

[Service]
Type=oneshot
User=cesmii
Group=cesmii
WorkingDirectory=/home/cesmii/repos/nerd-store
Environment=CONFIG_PATH=/home/cesmii/repos/nerd-store/config.json
ExecStart=/usr/bin/node /home/cesmii/repos/nerd-store/scripts/sweep-reservations.ts
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/cesmii/repos/nerd-store/data
