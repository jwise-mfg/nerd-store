{
  "name": "@store/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./schema": "./src/db/schema.ts",
    "./tenant": "./src/tenant/index.ts"
  },
  "scripts": {
    "db:generate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs generate",
