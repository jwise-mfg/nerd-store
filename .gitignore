# dependencies
node_modules/

# build output — deploy.sh builds on the server, never committed
dist/
apps/*/dist/
apps/*/dist-*/
.astro/
apps/*/.astro/

# configuration — copy config.example.json to config.json.
# config.json holds real keys and must never be committed.
config.json
config.*.json
!config.example.json
.env
.env.*

# tenant databases — one file per store, never in version control
data/
*.db
*.db-wal
*.db-shm

# operator notes
private/

# misc
*.log
.DS_Store

# deploy bookkeeping
.last-deploy
.deploy.lock.d/
