# Dependencies — nested workspaces put these several levels down.
node_modules/

# Composer packages — composer.lock is committed, vendor/ is not.
/vendor/

# Secrets. config.php at the root holds the Stripe and mail keys.
# stores/*/config.php holds no secrets and IS tracked.
/config.php
.env
.env.*

# The database, and any backup of it.
/data/
*.db
*.db-gz
*.db-wal
*.db-shm

# Operator notes
private/

# Misc
*.log
.DS_Store
merchandising/
