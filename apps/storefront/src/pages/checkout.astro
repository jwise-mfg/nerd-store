---
import Base from '../layouts/Base.astro'
import Checkout from '../components/Checkout.tsx'
import { TENANT } from '../lib/tenant.ts'
import { config } from '@store/core'

// The checkout shell is prerendered, so the publishable key is read from
// config at build time and inlined. It is designed to be public.
const t = TENANT
const c = t.theme.color
const pk = config().stripe.publishableKey
---
<Base title={t.copy.checkoutTitle}>
  <h1>{t.copy.checkoutTitle}</h1>
  {pk
    ? <Checkout
        client:load
        publishableKey={pk}
        tenant={{
          currency: t.currency,
          storeName: t.storeName,
          copy: { checkoutReassurance: t.copy.checkoutReassurance },
          appearance: {
            bg: c.bg, bgElevated: c.bgElevated, ink: c.ink, inkMuted: c.inkMuted,
            accent: c.accent, line: c.line, danger: c.danger,
            font: t.theme.font.sans, radius: t.theme.radius.sm,
          },
        }}
      />
    : <p class="notice">stripe.publishableKey is not set in config.json.</p>}
</Base>
