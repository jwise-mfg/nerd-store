---
import Base from '../../layouts/Base.astro'
import ProductCard from '../../components/ProductCard.astro'
import { TENANT } from '../../lib/tenant.ts'
import { listProducts, facetsFor } from '@store/core'

const t = TENANT
const products = listProducts(t)
const facets = facetsFor(t, products)
---
<Base title={t.copy.catalogTitle}>
  <h1>{t.copy.catalogTitle}</h1>

  {/* Facets are declared by the tenant, so this markup serves size/colour for
      one store and condition/storage/model for the other with no branching. */}
  <div style="margin-bottom: calc(var(--s) * 3);">
    {Object.entries(facets).map(([key, values]) =>
      values.length > 1 ? (
        <span style="margin-right: calc(var(--s) * 2);">
          <span class="muted" style="font-size:.85rem;">{key}:</span>
          {values.map((v) => (
            <a class="chip" style="margin-left:4px;" href={`/shop?${key}=${encodeURIComponent(v)}`}>{v}</a>
          ))}
        </span>
      ) : null,
    )}
  </div>

  {products.length === 0
    ? <p class="muted">{t.copy.catalogEmpty}</p>
    : <div class="grid" data-catalog>{products.map((p) => <ProductCard product={p} />)}</div>}
</Base>

<script is:inline>
  // Facet links are plain query strings so the page stays fully static and
  // shareable; filtering happens client-side against the rendered grid.
  (function () {
    var params = new URLSearchParams(location.search)
    if (![...params].length) return
    document.querySelectorAll('[data-catalog] [data-facets]').forEach(function (card) {
      var facets = JSON.parse(card.getAttribute('data-facets') || '{}')
      var match = [...params].every(function (kv) {
        return (facets[kv[0]] || []).includes(kv[1])
      })
      if (!match) card.remove()
    })
  })()
</script>
