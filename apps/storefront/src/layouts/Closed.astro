---
import { TENANT } from '../lib/tenant.ts'
import { themeCss } from '../lib/theme.ts'
import '../styles/app.css'
const t = TENANT
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.storeName}</title>
    <meta name="robots" content="noindex" />
    {t.brand.favicon && <link rel="icon" type="image/png" href={t.brand.favicon} />}
    {t.theme.font.googleFontsHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={t.theme.font.googleFontsHref} />
      </>
    )}
    <meta name="theme-color" content={t.theme.color.bg} />
    <style set:html={themeCss(t)}></style>
  </head>
  <body>
    <main class="wrap" style="min-height:70vh;display:flex;flex-direction:column;
                              align-items:center;justify-content:center;text-align:center;gap:calc(var(--s)*3);">
      {t.brand.mark && (
        <img src={t.brand.mark.src} alt="" width="512" height="512" style="height:96px;width:96px;" />
      )}
      {t.brand.wordmark
        ? <img src={t.brand.wordmark.src} alt={t.storeName} style="height:40px;width:auto;" />
        : <h1 style="margin:0;">{t.storeName}</h1>}
      <p style="font-size:1.25rem;margin:0;">Down for maintenance, back soon</p>
      <p class="muted" style="margin:0;">
        Questions? <a href={`mailto:${t.support.email}`}>{t.support.email}</a>
      </p>
    </main>
  </body>
</html>
