// ─────────────────────────────────────────────────────────────────────────
//  Copy this file to config.json and replace the REPLACE_ME values.
//
//      cp config.example.json config.json
//
//  config.json is gitignored and is the only place secrets belong.
//  This file is committed, so never put a real key in it.
//
//  Comments are allowed here and in config.json, the way tsconfig.json
//  allows them. Point CONFIG_PATH at a different file to override the
//  location (systemd uses /etc/nerd-store/config.json).
// ─────────────────────────────────────────────────────────────────────────
{
  "stripe": {
    // Test keys: https://dashboard.stripe.com/test/apikeys
    // Server-side only; never reaches the browser.
    "secretKey": "sk_test_REPLACE_ME",

    // Inlined into the checkout page at build time. Safe to expose.
    "publishableKey": "pk_test_REPLACE_ME",

    // From the webhook endpoint you register, or from `stripe listen`.
    //   Endpoint: https://<your-store>/api/webhook/stripe
    //   Events:   payment_intent.succeeded
    //             payment_intent.payment_failed
    //             payment_intent.canceled
    "webhookSecret": "whsec_REPLACE_ME"
  },

  "mail": {
    // How receipts are sent.
    //   "log"     write to the journal only (default; right for development)
    //   "resend"  Resend's HTTP API -- needs apiKey below
    //   "webhook" POST the message as JSON to webhookUrl, for routing into
    //             something of your own. NOT a way to reach a mail provider:
    //             the body is unauthenticated and provider-shaped APIs will
    //             reject it.
    "transport": "log",

    // https://resend.com/api-keys -- starts with re_
    // Verify each store's domain separately in Resend, so mail is signed as
    // d=i3x.dev and d=webosarchive.org rather than sharing one identity.
    "apiKey": null,

    "webhookUrl": null
  },

  // Where YOU are told about new orders. Both optional; with neither set, a
  // sale is announced only in the journal. Distinct from mail above, which is
  // what the customer receives.
  "notify": {
    // Emailed on every paid order, through the mail transport above.
    "email": null,

    // https://pushover.net -- create an application to get a token; the user
    // key is on your dashboard.
    //
    // "sound" takes a built-in name or a custom sound uploaded to your
    // application. Give each store its own and you know which one sold
    // without looking. Omit it for Pushover's default.
    //   "sound": "cashregister"
    //   "sound": { "i3x": "cashregister", "webos": "webos-notify" }
    //
    // "priority": -2 quiet, 0 normal, 1 high, 2 needs acknowledgement.
    // "device": limit to one device by name; omit to reach all of them.
    "pushover": null
    // "pushover": {
    //   "token": "REPLACE_ME",
    //   "user": "REPLACE_ME",
    //   "sound": { "i3x": "cashregister", "webos": "webos-notify" }
    // }
  },

  "storage": {
    // Directory holding one SQLite file per store. A relative path is
    // resolved against the repository root, not the working directory.
    // systemd sets this to /var/lib/nerd-store.
    "dataDir": "./data",

    // Optional per-store overrides, e.g. to put one on a separate volume.
    "databasePaths": {
      // "i3x": "/var/lib/nerd-store/i3x.db",
      // "webos": "/mnt/data/webos.db"
    }
  }
}
