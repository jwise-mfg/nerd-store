# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to .env and replace the stub values.
#
#      cp .env.example .env
#
#  .env is gitignored and is the ONLY place secrets belong. Never put a real
#  key in this file — it is committed, and anything here is public.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────────
# Stripe. One account serves both stores; the code gives each its own
# statement descriptor, receipts, and order references.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Created when you register the webhook endpoint (or by `stripe listen`).
# Endpoint: https://<your-store>/api/webhook/stripe
# Events:   payment_intent.succeeded, payment_intent.payment_failed,
#           payment_intent.canceled
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Where receipt emails are POSTed. Leave empty to log them to stdout instead,
# which is what you want in development.
MAIL_WEBHOOK_URL=

# ── Storage ──────────────────────────────────────────────────────────────
# One SQLite file per store, created under this directory. Relative paths are
# resolved against the repository root, not the working directory.
# Production (systemd) sets this to /var/lib/nerd-store.
DATA_DIR=./data

# Optional: place a store's database somewhere specific, e.g. a separate
# volume. Overrides DATA_DIR for that tenant only.
# DATABASE_PATH_I3X=/var/lib/nerd-store/i3x.db
# DATABASE_PATH_WEBOS=/var/lib/nerd-store/webos.db

# ── Runtime ──────────────────────────────────────────────────────────────
# Which store this process serves. Set per build and per systemd unit, not
# here — listed for reference. One of: i3x, webos
# TENANT=i3x

# Bind address and port for the Node server. systemd sets these per unit.
# HOST=127.0.0.1
# PORT=4321
