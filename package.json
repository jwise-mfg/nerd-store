{
  "name": "nerd-store",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:i3x": "TENANT=i3x npm run dev -w @store/storefront",
    "dev:webos": "TENANT=webos npm run dev -w @store/storefront",
    "build:i3x": "TENANT=i3x npm run build -w @store/storefront",
    "build:webos": "TENANT=webos npm run build -w @store/storefront",
    "build:all": "npm run build:i3x && npm run build:webos",
    "db:generate": "npm run db:generate -w @store/core",
    "db:migrate": "node --env-file=.env packages/core/src/db/migrate.ts",
    "db:seed": "node --env-file=.env packages/core/src/db/seed.ts",
    "db:studio": "npm run db:studio -w @store/core",
    "test:oversell": "node --env-file=.env scripts/test-oversell.ts",
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "test:availability": "node --env-file=.env scripts/test-availability.ts",
    "test": "npm run test:availability && npm run test:oversell && npm run validate",
    "validate": "node scripts/validate-tenants.mjs",
    "validate:dist": "node scripts/validate-tenants.mjs --dist"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}