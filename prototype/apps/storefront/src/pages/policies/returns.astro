---
import Base from '../../layouts/Base.astro'
import { TENANT } from '../../lib/tenant.ts'
const t = TENANT
// Policy text differs materially between the stores: one sells new merch,
// the other sells graded used electronics, and their obligations are not the
// same. Both are driven from the tenant config rather than hardcoded here.
const usedGoods = t.catalog.showConditionDetail
---
<Base title="Returns">
  <h1>Returns</h1>
  {usedGoods ? (
    <>
      <p>Every device is tested before it ships and listed with photographs of the actual unit,
         including any cosmetic flaws. Condition grades are described on each listing.</p>
      <p><strong>30-day functional warranty.</strong> If a device does not work as described,
         contact us within 30 days of delivery for a replacement or a full refund including
         return shipping.</p>
      <p><strong>Change of mind.</strong> Returns accepted within 14 days in the condition sent.
         Return shipping is yours; the item price is refunded in full.</p>
      <p>New old stock accessories may be returned within 30 days if the seal is unbroken.</p>
    </>
  ) : (
    <>
      <p>Unworn, unwashed items and unopened books may be returned within 30 days of delivery
         for a full refund.</p>
      <p>If something arrives damaged or misprinted, contact us and we will replace it at no
         cost — no return needed.</p>
      <p>Return shipping for change-of-mind returns is yours; we cover it for our errors.</p>
    </>
  )}
  <p>Start a return by emailing <a href={`mailto:${t.support.email}`}>{t.support.email}</a> with
     your order number.</p>
  <p class="muted" style="font-size:.9rem;">Refunds appear on your statement as
     “{t.statementDescriptorSuffix}” and take 5–10 business days to post.</p>
</Base>
