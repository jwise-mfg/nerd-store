---
import Base from '../../layouts/Base.astro'
import { TENANT } from '../../lib/tenant.ts'
import { getOrder, formatMoney } from '@store/core'

// Server-rendered: an order confirmation is per-customer and must never be
// prerendered or cached.
export const prerender = false

const t = TENANT
const { orderNumber } = Astro.params
const found = orderNumber ? getOrder(t, orderNumber) : null
// Reaching a confirmation page for a real order means that cart is finished.
// The webhook empties it server-side, but it can arrive seconds after the
// Stripe redirect, and until then the shopper would see a stale cart badge.
// Only when the order was actually found, so someone opening a stranger's
// order URL does not lose their own basket.
if (found) Astro.cookies.delete(t.cartCookie, { path: '/' })

Astro.response.headers.set('cache-control', 'no-store')
Astro.response.headers.set('x-robots-tag', 'noindex')
---
<Base title={`Order ${orderNumber}`}>
  {!found ? (
    <>
      <h1>We couldn’t find that order</h1>
      <p class="muted">Check the link in your confirmation email, or contact <a href={`mailto:${t.support.email}`}>{t.support.email}</a>.</p>
    </>
  ) : (
    <>
      <h1>{t.copy.orderConfirmedTitle}</h1>
      <p>{t.copy.orderConfirmedBody}</p>
      <p class="muted">
        Order <strong style="font-family:var(--f-mono);">{found.order.orderNumber}</strong>
        {found.order.status === 'pending' && (
          <span data-pending-note> — payment is still confirming…</span>
        )}
      </p>

      <table class="table" style="margin-top:calc(var(--s)*4);">
        <tbody>
          {found.items.map((i) => (
            <tr>
              <td>
                {i.titleSnapshot}
                {i.serialSnapshot && <div class="muted" style="font-family:var(--f-mono);font-size:.85rem;">S/N {i.serialSnapshot}</div>}
              </td>
              <td style="text-align:right;width:60px;">×{i.qty}</td>
              <td style="text-align:right;width:100px;" class="price">{formatMoney(i.qty * i.unitPriceCents, found.order.currency)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="totals">
        <div><span>Subtotal</span><span>{formatMoney(found.order.subtotalCents, found.order.currency)}</span></div>
        <div><span>Shipping</span><span>{formatMoney(found.order.shippingCents, found.order.currency)}</span></div>
        <div class="grand"><span>Total</span><span>{formatMoney(found.order.totalCents, found.order.currency)}</span></div>
      </div>

      <p class="muted" style="margin-top:calc(var(--s)*4);font-size:.9rem;">
        Your card statement will show “{t.statementDescriptorSuffix}”.
      </p>
    </>
  )}
  {found && found.order.status === 'pending' && (
    <script is:inline define:vars={{ orderNumber: found.order.orderNumber }}>
      // The Stripe redirect usually beats the webhook, so this page often
      // renders before the payment is recorded. Poll until it is, then reload
      // so the whole page reflects the real state rather than patching it.
      (function () {
        var note = document.querySelector('[data-pending-note]')
        var started = Date.now()
        var LIMIT = 90000

        function stop(message) {
          if (note) note.textContent = message
        }

        function check() {
          if (Date.now() - started > LIMIT) {
            stop(' — still processing. You will get a confirmation email once it clears;' +
                 ' if it does not arrive shortly, contact us with this order number.')
            return
          }
          fetch('/api/order-status?number=' + encodeURIComponent(orderNumber), { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null })
            .then(function (d) {
              if (d && d.status && d.status !== 'pending') location.reload()
              else setTimeout(check, 2000)
            })
            .catch(function () { setTimeout(check, 4000) })
        }
        setTimeout(check, 1500)
      })()
    </script>
  )}
</Base>
